# ── Supabase ──────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Resend (transactional email) ──────────────────────────
RESEND_API_KEY=re_...
# Verified sender address (must be on a domain verified in Resend).
RESEND_FROM_EMAIL="LunarLogic Training <trainer@yourdomain.com>"

# ── App ───────────────────────────────────────────────────
# Public base URL, used to build intake links and email links.
# No trailing slash. e.g. https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
